# Backend API
API_BASE_URL=http://localhost:8000/api/v1
API_USERNAME=admin
API_PASSWORD=changeme

# Session persistence directory
SESSION_DIR=./session

# WhatsApp Web URL
WA_URL=https://web.whatsapp.com

# Browser options
HEADLESS=false

# Polling interval in ms (how often to check for new messages)
POLL_INTERVAL=5000

# How many chats to scan on startup
CHAT_SCAN_LIMIT=20

# Logging level: debug | info | warn | error
LOG_LEVEL=info

# ── Media Download ────────────────────────────────────────────────────────────
# Set to false to disable downloading media files (metadata still stored)
DOWNLOAD_MEDIA=true

# Directory where media files are saved (relative to wa-playwright/)
DOWNLOAD_DIR=../downloads

# Optional: send a test message on startup
# TEST_SEND_CONTACT=
# TEST_SEND_MESSAGE=
